# GateWatch ML - ignorate locale pentru directorul ml/

# Mediu virtual Python
.venv/

# Cache Python
__pycache__/
*.py[cod]
*.pyc

# Fisiere temporare
*.tmp
*.log
*.swp
Thumbs.db
.DS_Store

# Capturi video si cadre locale - scriptul nu salveaza nimic,
# dar excludem orice fisier aparut accidental in timpul testarii
*.avi
*.mp4
*.mkv
*.mov
*.webm
*.jpg
*.jpeg
*.png
*.bmp

# Camera-specific calibration stays on the capture laptop.
models/video_camera.joblib
models/video_camera_card.json
models/video_camera.backup-*.joblib
